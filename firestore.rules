rules_version = '2';

// Veysel Ustam - Firestore güvenlik kuralları
//
// Yönetici = Firebase Authentication'da giriş yapmış VE uid'si "admins"
// koleksiyonunda belge olarak duran hesap. "admins" koleksiyonuna sitenin
// kendisi yazamaz; belge yalnızca Firebase konsolundan elle eklenir.
// Kurulum adımları: FIREBASE_GUVENLIK.md

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Yönetici listesi: herkes yalnızca kendi kaydının varlığını görebilir,
    // kimse siteden yazamaz.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Satışta stok düşümü: müşteri bir stok sayısını yalnızca AYNI işlemde
    // oluşturduğu yeni siparişin "stockDeductions" alanında yazan adet kadar
    // azaltabilir. Başka alana dokunamaz, stok eksiye düşemez ve her sipariş
    // yalnızca bir kez oluşturulabildiği için aynı düşüm tekrarlanamaz.
    function stockSale(kind, id) {
      let orderPath = /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastOrderId'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && !exists(orderPath)
        && existsAfter(orderPath)
        && getAfter(orderPath).data.stockDeductions[kind][id]
             == resource.data.stock - request.resource.data.stock;
    }

    // Ürünler: herkes okur, yalnızca yönetici değiştirir (satışta stok düşümü hariç).
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if stockSale('products', productId);
    }

    // Ortak stok grupları (ör. "Sidre" kasası): herkes okur, yönetici yönetir.
    match /stockGroups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if stockSale('groups', groupId);
    }

    // Siparişler: müşteri (misafir dahil) yalnızca "pending" durumunda yeni
    // sipariş oluşturabilir. Sipariş numarası (belge kimliği) rastgele ve
    // tahmin edilemez olduğu için tek bir siparişi numarasıyla açmak serbest
    // (sipariş onay sayfası bunu kullanıyor); listeleme ve güncelleme yalnızca
    // yöneticide.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.userId == (signedIn() ? request.auth.uid : 'guest_user')
        && !('restocked' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Ziyaret istatistikleri: site her sayfa görüntülemesinde bir kayıt açar
    // (IP saklanmaz; konum şehir düzeyinde). Yalnızca yönetici okur/siler.
    // Kayıt açılırken süre 0 ve zaman sunucu saati olmalı; sonra yalnızca
    // "seconds" alanı artırılabilir (en fazla 4 saat).
    function shortStr(v, n) {
      return v is string && v.size() <= n;
    }
    function validPageview(d) {
      return d.keys().hasOnly(['sid', 'path', 'productId', 'at', 'seconds', 'country', 'region', 'city',
                               'device', 'ref', 'utmSource', 'utmMedium', 'utmCampaign', 'lang', 'landing'])
        && shortStr(d.sid, 40) && d.sid.size() >= 8
        && shortStr(d.path, 200) && shortStr(d.productId, 80)
        && shortStr(d.country, 8) && shortStr(d.region, 60) && shortStr(d.city, 80)
        && d.device in ['mobile', 'tablet', 'desktop']
        && shortStr(d.ref, 120) && shortStr(d.utmSource, 60) && shortStr(d.utmMedium, 60)
        && shortStr(d.utmCampaign, 80) && shortStr(d.lang, 5) && d.landing is bool;
    }
    match /pageviews/{viewId} {
      allow read, delete: if isAdmin();
      allow create: if validPageview(request.resource.data)
        && request.resource.data.seconds == 0
        && request.resource.data.at == request.time;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seconds'])
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= resource.data.seconds
        && request.resource.data.seconds <= 14400;
    }

    // Müşteri yorumları: herkes yalnızca onaylanmış yorumları okur. Siteden
    // gelen yorum "pending" (onay bekliyor) olarak açılır; yönetici onaylar,
    // siler ya da WhatsApp gibi başka yerden gelen yorumu doğrudan ekler.
    function validReview(d) {
      return d.keys().hasOnly(['productId', 'name', 'rating', 'text', 'lang', 'status', 'source', 'createdAt'])
        && d.productId is string && d.productId.size() > 0 && d.productId.size() <= 80
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.text is string && d.text.size() >= 3 && d.text.size() <= 1500
        && d.lang is string && d.lang.size() <= 5
        && d.source in ['site', 'whatsapp', 'instagram'];
    }
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if validReview(request.resource.data)
        && ((request.resource.data.status == 'pending'
             && request.resource.data.source == 'site'
             && request.resource.data.createdAt == request.time)
            || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Müşteri profilleri: herkes yalnızca kendi profilini görür / yazar ve
    // kendine "admin" rolü veremez.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'customer') == 'customer';
      allow delete: if isAdmin();
    }

    // Site ayarları. "adminLogin" belgesi giriş ekranındaki kullanıcı adını
    // e-postaya çevirmek için herkese açık okunur; şifre içermez.
    match /settings/{docId} {
      allow read: if docId == 'adminLogin' || isAdmin();
      allow write: if isAdmin();
    }

    // Yukarıda sayılmayan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
