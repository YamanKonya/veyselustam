rules_version = '2';

// Veysel Ustam - Storage güvenlik kuralları
// Dosyaları herkes görebilir (ürün görselleri/videoları), yalnızca yönetici
// yükler veya siler. Yönetici kontrolü Firestore'daki "admins" koleksiyonuna
// bakar (firestore.rules ile aynı kural).

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }
  }
}
